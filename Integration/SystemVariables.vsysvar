<?xml version="1.0" encoding="utf-8"?>
<systemvariables version="4">
  <namespace name="LoadManager" comment="">
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="CurrentLoad" comment="Actual measured bus load this 100ms window. Written by LoadMonitor.can every 100ms." bitcount="64" isSigned="true" encoding="65001" type="float" startValue="0" minValue="0" maxValue="100" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="PredictedLoad" comment="EWMA predicted bus load for next window. Written by LoadMonitor.can every 100ms." bitcount="64" isSigned="true" encoding="65001" type="float" startValue="0" minValue="0" maxValue="100" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="PredictionAccuracy" comment="100 minus absolute prediction error. Written by LoadMonitor.can every 100ms." bitcount="64" isSigned="true" encoding="65001" type="float" startValue="0" minValue="0" maxValue="100" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="Alpha" comment="EWMA smoothing factor. Read by LoadMonitor.can on every tick. Adjustable via panel radio buttons." bitcount="64" isSigned="true" encoding="65001" type="float" startValue="0.3" minValue="0.05" maxValue="0.95" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="Threshold" comment="Bus load % that triggers deferral. Read by LoadMonitor.can each tick. Panel slider controls." bitcount="64" isSigned="true" encoding="65001" type="float" startValue="70" minValue="50" maxValue="95" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="DeferralActive" comment="Deferral flag. 0=Normal, 1=Deferral ON. Written by LoadMonitor.can. Read by BodyControl.can and BatteryECU.can before every output() call." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="DeferralCount" comment="Total number of deferral events this session. Incremented by BodyControl.can and BatteryECU.can each time they skip a transmission." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="99999" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="TotalMessages" comment="Cumulative CAN frames counted since session start. Incremented by LoadMonitor.can on every message." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="2147483647" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="PeakLoad" comment="Highest bus load recorded this session. Updated by LoadMonitor.can: if(currentLoad > PeakLoad) PeakLoad = currentLoad;" bitcount="64" isSigned="true" encoding="65001" type="float" startValue="0" minValue="0" maxValue="100" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="AverageLoad" comment="Running average bus load this session. Computed as CumulativeSum / SampleCount." bitcount="64" isSigned="true" encoding="65001" type="float" startValue="0" minValue="0" maxValue="100" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="RMSE" comment="Root Mean Squared Error of EWMA predictions. Formula: sqrt(SumSquaredErrors / SampleCount) Updated by LoadMonitor.can every 100ms." bitcount="64" isSigned="true" encoding="65001" type="float" startValue="0" minValue="0" maxValue="100" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="SessionTime" comment="Elapsed simulation time in seconds. Incremented by LoadMonitor.can every 1000ms. Displayed on panel Section 5 session timer." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="99999" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="SampleCount" comment="Number of 100ms samples taken this session. Required for AverageLoad and RMSE calculations. Incremented by LoadMonitor.can every 100ms tick." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="999999" />
  </namespace>
  <namespace name="NodeStatus" comment="">
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="Node_Engine_Status" comment="EngineECU status. Written by EngineECU.can." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="Node_ADAS_Status" comment="ADAS_ECU status. Written by ADAS_ECU.can." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="Node_BCM_Status" comment="BodyControl status. 2=Deferred. Written by BodyControl.can." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="2" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="Node_Battery_Status" comment="BatteryECU status. 2=Deferred. Written by BatteryECU.can." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="2" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="Node_CrashSensor_Status" comment="CrashSensor status. Written by CrashSensor.can." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="Node_ACU_Status" comment="ACU status. Set to 1 during crash processing. Written by ACU.can." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="Node_Fault_Status" comment="FaultInjector status. 0=Inactive, 1=Active. Written by FaultInjector.can." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
  </namespace>
  <namespace name="CrashSafety" comment="">
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="SimulateCrash" comment="Panel button trigger. Set to 1 by panel button. Read and immediately reset to 0 by CrashSensor.can." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="CrashSentTime" comment="Timestamp when CRASH_Detected was sent. Written by CrashSensor.can using timeNow()." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="2147483647" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="CrashToACU_Latency_Actual" comment="Transit time from crash send to ACU receive without algorithm." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="9999" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="TotalDeployTime_Actual" comment="Total time from crash event to AIRBAG_Deploy send without algorithm." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="9999" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="CrashToACU_Latency_Predicted" comment="Transit time from crash send to ACU receive with algorithm." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="9999" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="TotalDeployTime_Predicted" comment="Total time from crash event to AIRBAG_Deploy send with algorithm." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="9999" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="SafetyBreach" comment="1 if CrashToACU_Latency exceeds 30ms (ISO 26262). Written by ACU.can. Drives RED alert on panel." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="AirbagDeployed" comment="Airbag deployment status. Set to 1 by ACU.can after deploying. Guards against double-fire." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="ResetCrash" comment="Panel reset button for crash safety section. When set to 1, ACU.can resets all CrashSafety variables to initial values, then sets itself back to 0. Allows repeated crash tests." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
  </namespace>
  <namespace name="FaultInjection" comment="">
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="InjectFault" comment="Fault injection start trigger. Set to 1 by panel Inject button. Read by FaultInjector.can." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="StopFault" comment="Fault injection stop trigger. Set to 1 by panel Stop button. Immediately halts burst." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="ScenarioType" comment="Fault scenario selector. 0 = Idle (no scenario active) 1 = Sudden Burst (instant flood) 2 = Ramp (gradual increase) 3 = Cascade (multi-ECU fault simulation) Set by panel dropdown." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="3" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="BurstIntensity" comment="Flood message rate level. 0 = Low (~50 extra messages per 100ms) 1 = Medium (~150 extra messages per 100ms) 2 = High (~300 extra messages per 100ms) Set by panel slider." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="1" minValue="0" maxValue="2" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="FaultStatus" comment="Current injection status. 0=Inactive, 1=Active. Written by FaultInjector.can. Read by panel Section 6 status display." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="0" minValue="0" maxValue="1" />
    <variable anlyzLocal="2" readOnly="false" valueSequence="false" physOnly="false" name="FaultDuration_Setting" comment="Auto-stop duration. FaultInjector.can stops injection after this many seconds automatically. Set by panel duration slider." bitcount="32" isSigned="true" encoding="65001" type="int" startValue="10" minValue="1" maxValue="60" />
  </namespace>
</systemvariables>
